APP_NAME=dataquality-platform
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated list of browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql+psycopg://dq_user:dq_password@localhost:5432/dataquality
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# HS256 signing secret for access/refresh JWTs. Generate a real random value
# for anything beyond local development, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=local-dev-secret-change-me-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Fernet key (32 url-safe base64 bytes) used ONLY by the local-dev credential
# vault stub (app/modules/connections/credential_vault.py). Generate your own
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not reuse this value, and do not use this vault implementation, outside
# local development.
VAULT_LOCAL_ENCRYPTION_KEY=auxfxLith1IRMEbLccKJOaae4X4dQf7IITmLV3NpVS0=

# Bounded timeout applied to every source_adapters provider method call during discovery.
DISCOVERY_QUERY_TIMEOUT_SECONDS=30
# Threshold for jobs.sweep_stale_jobs: a RUNNING job whose updated_at (not started_at)
# is older than this is marked FAILED by the watchdog.
STALE_JOB_THRESHOLD_MINUTES=60

# Bounded timeout for ordinary profiling provider calls (sample_rows, etc).
PROFILING_QUERY_TIMEOUT_SECONDS=30
# A full-table COUNT(DISTINCT ...) pushdown is heavier than a single query,
# so it gets its own, larger timeout budget rather than sharing the above.
PROFILING_EXACT_STATS_TIMEOUT_SECONDS=60
# get_dataset_column_stats() batches columns into queries of at most this size.
PROFILING_EXACT_STATS_MAX_COLUMNS_PER_QUERY=25
# Overall wall-clock budget for one dataset's profiling run.
PROFILING_DATASET_TIMEOUT_SECONDS=300
# Used when a profile request omits sample_size.
PROFILING_DEFAULT_SAMPLE_SIZE=30000
# An explicit sample_size above this is rejected with 422, never downgraded.
PROFILING_MAX_SAMPLE_SIZE=200000
# full_scan=true is rejected with 422 if datasets.row_count_estimate exceeds this.
PROFILING_MAX_FULL_SCAN_ROWS=5000000

# Caps persisted validation_failures rows per run; evaluation and aggregate
# counts/quality_score are never affected once the cap is reached.
VALIDATION_MAX_FAILURES=10000
# Overall wall-clock budget for one validation run's expensive full-dataset
# operations (CROSS_COLUMN, and DUPLICATE when no push-down is available).
VALIDATION_DATASET_TIMEOUT_SECONDS=300
